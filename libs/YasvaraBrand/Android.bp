package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// The Yasvara brand in Compose (SPEC-0004 §4.1): the mark and its states, the voice ripple and
// the Expressive shape helpers, with motion taken only from MaterialTheme.motionScheme. The
// mark's geometry is generated by branding/export_logo.py --kotlin, so it matches every PNG.
android_library {
    name: "YasvaraBrand",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.kt"],
    static_libs: [
        "androidx.compose.animation_animation-core",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.graphics_graphics-shapes",
        "kotlinx_coroutines_android",
    ],
    sdk_version: "current",
    min_sdk_version: "31",
    kotlincflags: ["-Xjvm-default=all"],
}
