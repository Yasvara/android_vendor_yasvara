package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "yasvara.pasang",
    unstable: true,
    local_include_dir: ".",
    srcs: ["yasvara/pasang/IPasang.aidl"],
    backend: {
        cpp: {
            enabled: true,
        },
        java: {
            enabled: true,
            platform_apis: true,
        },
        ndk: {
            enabled: false,
        },
        rust: {
            enabled: false,
        },
    },
}
