// Pasang — Zero-dependency Rust In-OS Live CoW OTA Engine, CLI (`pasang`),
// and lazy native AIDL daemon (`pasangd`).

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "pasang_opt_defaults",
    edition: "2021",
    flags: [
        "-C", "opt-level=3",
        "-C", "codegen-units=1",
    ],
    lints: "vendor",
    clippy_lints: "vendor",
}

rust_defaults {
    name: "pasang_core_defaults",
    defaults: ["pasang_opt_defaults"],
    crate_name: "pasang_core",
    srcs: ["crates/pasang-core/src/lib.rs"],
}

rust_library {
    name: "libpasang_core",
    defaults: ["pasang_core_defaults"],
    host_supported: true,
    recovery_available: true,
}

rust_ffi_static {
    name: "libpasang_core_ffi",
    defaults: ["pasang_core_defaults"],
    recovery_available: true,
}

rust_test_host {
    name: "pasang_core_test",
    crate_name: "pasang_core",
    srcs: ["crates/pasang-core/src/lib.rs"],
    edition: "2021",
    test_suites: ["general-tests"],
}

// Thin C++ lazy AIDL daemon (`/system_ext/bin/pasangd`) + multi-call CLI symlink (`/system_ext/bin/pasang`).
// Single binary shares libzstd, liblzma, libbz, BoringSSL, and BootControlClient with zero duplication!
cc_binary {
    name: "pasangd",
    system_ext_specific: true,
    symlinks: ["pasang"],
    srcs: [
        "daemon/main.cpp",
        "daemon/boot_control_shim.cpp",
    ],
    local_include_dirs: ["daemon/include"],
    init_rc: ["daemon/pasangd.rc"],
    static_libs: [
        "libpasang_core_ffi",
        "yasvara.pasang-cpp",
        "libzstd",
        "libbz",
        "liblzma",
    ],
    shared_libs: [
        "android.hardware.boot@1.0",
        "android.hardware.boot@1.1",
        "android.hardware.boot@1.2",
        "android.hardware.boot-V1-ndk",
        "libbase",
        "libbinder",
        "libboot_control_client",
        "libcrypto",
        "libhidlbase",
        "liblog",
        "libutils",
        "libziparchive",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-O3",
    ],
}

// Pulih 120 Hz Material You 2D Engine (`pulih-gfx`)
rust_library {
    name: "libpulih_gfx",
    defaults: ["pasang_opt_defaults"],
    crate_name: "pulih_gfx",
    srcs: ["crates/pulih-gfx/src/lib.rs"],
    host_supported: true,
    recovery_available: true,
}

rust_test_host {
    name: "pulih_gfx_test",
    crate_name: "pulih_gfx",
    srcs: ["crates/pulih-gfx/src/lib.rs"],
    edition: "2021",
    test_suites: ["general-tests"],
}

// Thin C++ QTI SDE / KMS triple-buffered DRM, evdev, haptics, dm-linear & BoringSSL HTTPS shim for Pulih
cc_library_static {
    name: "libpulih_drm_shim",
    recovery_available: true,
    srcs: ["crates/pulih/shim/pulih_drm_shim.cpp"],
    shared_libs: [
        "libdrm",
        "libssl",
        "libcrypto",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-O3",
    ],
}

// Pulih recovery library (shared by `pulih` binary and host `pulih_test`)
rust_library {
    name: "libpulih",
    defaults: ["pasang_opt_defaults"],
    crate_name: "pulih",
    srcs: ["crates/pulih/src/lib.rs"],
    host_supported: true,
    recovery_available: true,
    rustlibs: [
        "libpasang_core",
        "libpulih_gfx",
    ],
    target: {
        android: {
            static_libs: ["libpulih_drm_shim"],
            shared_libs: [
                "libdrm",
                "libssl",
                "libcrypto",
            ],
        },
    },
}

// Pulih Full-Rust 120 Hz Material You Recovery binary (`/system/bin/pulih` in recovery ramdisk)
rust_binary {
    name: "pulih",
    defaults: ["pasang_opt_defaults"],
    recovery: true,
    srcs: ["crates/pulih/src/main.rs"],
    rustlibs: [
        "libpasang_core",
        "libpulih",
        "libpulih_gfx",
    ],
    static_libs: ["libpulih_drm_shim"],
    shared_libs: [
        "libdrm",
        "libssl",
        "libcrypto",
    ],
}

// TWRP / OrangeFox / OpenRecoveryScript multi-call CLI symlinks in recovery ramdisk
install_symlink {
    name: "pulih_twrp_link",
    recovery: true,
    installed_location: "bin/twrp",
    symlink_target: "pulih",
}

install_symlink {
    name: "pulih_fox_link",
    recovery: true,
    installed_location: "bin/fox",
    symlink_target: "pulih",
}

install_symlink {
    name: "pulih_ors_link",
    recovery: true,
    installed_location: "bin/ors",
    symlink_target: "pulih",
}

// Standard Android UI automation symlinks (`screencap` & `input`) for AI agents / CI!
install_symlink {
    name: "pulih_screencap_link",
    recovery: true,
    installed_location: "bin/screencap",
    symlink_target: "pulih",
}

install_symlink {
    name: "pulih_input_link",
    recovery: true,
    installed_location: "bin/input",
    symlink_target: "pulih",
}

rust_test_host {
    name: "pulih_test",
    crate_name: "pulih",
    srcs: ["crates/pulih/src/lib.rs"],
    edition: "2021",
    rustlibs: [
        "libpasang_core",
        "libpulih_gfx",
    ],
    test_suites: ["general-tests"],
}
