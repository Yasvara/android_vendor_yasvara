# Yasvara attestation service, registered by system_server under
# "yasvara_attestation" (frameworks/base SystemServer). Reads are open to apps
# by design; writes are gated by yasvara.permission.WRITE_ATTESTATION. Without
# a label it fell back to default_android_service, which system_server may not
# add and apps may not find.
type yasvara_attestation_service, app_api_service, system_server_service, service_manager_type;

# Per-app update policy, "yasvara_update_policy". Every call needs
# yasvara.permission.MANAGE_UPDATE_POLICY, so only Laras and Settings look it up.
# "yasvara_app_visibility" shares the label: same callers, gated by its own permission.
type yasvara_update_policy_service, system_server_service, service_manager_type;

# Name and web filtering, "yasvara_saring". Any app may ask for the read-only name table
# its WebViews filter with; every other call needs yasvara.permission.MANAGE_SARING.
type yasvara_saring_service, app_api_service, system_server_service, service_manager_type;

# Layang floating windows, "yasvara_layang" plus the alias "layang" so
# `cmd layang` works. Every call needs yasvara.permission.MANAGE_LAYANG; shell can
# already find every service_manager_type that is not excluded in shell.te.
type yasvara_layang_service, system_server_service, service_manager_type;

# Swara per-app audio, "yasvara_swara". Every call needs
# yasvara.permission.MANAGE_SWARA: SystemUI (Volume Panel "Apps") and Laras.
type yasvara_swara_service, system_server_service, service_manager_type;

# Pentas session control, "yasvara_pentas". It exposes only dump, so
# nothing looks it up but dumpsys.
type yasvara_pentas_service, system_server_service, service_manager_type;

# Gboard flag overrides, "yasvara_ketik". Every call needs
# yasvara.permission.MANAGE_KETIK, so only Laras looks it up.
type yasvara_ketik_service, system_server_service, service_manager_type;

# Hentak game haptics, "yasvara_hentak". Its one transaction takes events from audioserver
# and checks the caller is audioserver; dumpsys reads the state.
type yasvara_hentak_service, system_server_service, service_manager_type;

# Pantau lazy native telemetry & HUD daemon, "yasvara.pantau".
type yasvara_pantau_service, service_manager_type;

# Padat lazy native F2FS compression daemon, "yasvara.padat".
type yasvara_padat_service, service_manager_type;

# Padat system_server manager service, "yasvara_padat" + "padat" alias.
type yasvara_padat_mgr_service, system_server_service, service_manager_type;

# Pasang lazy native In-OS Live CoW OTA daemon, "yasvara.pasang".
type yasvara_pasang_service, service_manager_type;
