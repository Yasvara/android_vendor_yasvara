// SPDX-License-Identifier: GPL-3.0-or-later
//
// ROM-integrated, rootless Xposed (Vector / LSPlant based). See native/build.sh for why the
// native half is a checked-in prebuilt, and frameworks/base for the `// Yasvara:` seams that
// load it into processes the user scoped.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// The binder contracts between a scoped process and the service in system_server. Both sides
// link this library, each from its own copy.
java_library {
    name: "yasvara-xposed-ipc",
    srcs: ["runtime/ipc/**/*.aidl"],
    aidl: {
        local_include_dirs: ["runtime/ipc"],
    },
    platform_apis: true,
    installable: false,
    visibility: ["//visibility:public"],
}

// Compile-time only: xposed.dummy.* is generated in memory on the device by the native bridge,
// and the libxposed annotations are CLASS retained metadata.
java_library {
    name: "yasvara-xposed-stubs",
    srcs: ["runtime/stubs/**/*.java"],
    platform_apis: true,
    installable: false,
}

// The Java half of the framework: the Xposed bridge, the libxposed API and the glue that boots
// them. Loaded with a DexClassLoader from /system_ext/framework by libyasvara_xposed.so, and only
// into processes system_server flagged as scoped.
java_library {
    name: "yasvara-xposed",
    srcs: [
        "runtime/java/**/*.java",
        "runtime/kotlin/**/*.kt",
        "runtime/loader/**/*.kt",
    ],
    static_libs: [
        "yasvara-xposed-ipc",
        "kotlin-stdlib",
    ],
    libs: [
        "yasvara-xposed-stubs",
        "androidx.annotation_annotation",
    ],
    platform_apis: true,
    system_ext_specific: true,
    installable: true,
    sdk_version: "",
    kotlincflags: ["-Xjvm-default=all"],
    // Not on any classpath: dexopt'ed like a standalone system_ext jar and nothing more.
    dex_preopt: {
        enabled: true,
    },
}

cc_prebuilt_library_shared {
    name: "libyasvara_xposed",
    system_ext_specific: true,
    compile_multilib: "both",
    srcs: [],
    arch: {
        arm64: {
            srcs: ["prebuilt/arm64-v8a/libyasvara_xposed.so"],
        },
        arm: {
            srcs: ["prebuilt/armeabi-v7a/libyasvara_xposed.so"],
        },
    },
    strip: {
        none: true,
    },
    stl: "none",
    check_elf_files: false,
    prefer: true,
}
