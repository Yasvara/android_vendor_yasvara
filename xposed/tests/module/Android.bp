// SPDX-License-Identifier: GPL-3.0-or-later
//
// A minimal legacy (de.robv) Xposed module used to exercise the rootless runtime on a device.
// Not part of any product: build it by name and `adb install` it.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "YasvaraXposedTestModule",
    srcs: ["src/**/*.java"],
    libs: ["yasvara-xposed"],
    platform_apis: true,
    manifest: "AndroidManifest.xml",
    optimize: {
        enabled: false,
    },
    dex_preopt: {
        enabled: false,
    },
    certificate: "platform",
}
