// SPDX-FileCopyrightText: The Yasvara Project
// SPDX-License-Identifier: GPL-3.0-or-later
//
// Kait in-tree Rust native core + host unit tests.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_library {
    name: "libkait_dex",
    crate_name: "kait_dex",
    srcs: ["dex/src/lib.rs"],
    edition: "2021",
    host_supported: true,
}

rust_test_host {
    name: "kait_dex_test",
    srcs: ["dex/src/lib.rs"],
    edition: "2021",
    test_suites: ["general-tests"],
}

rust_library {
    name: "libkait_hook",
    crate_name: "kait_hook",
    srcs: ["hook/src/lib.rs"],
    edition: "2021",
    host_supported: true,
    rustlibs: [
        "libhashbrown",
        "libparking_lot",
        "libsmallvec",
    ],
}

rust_test_host {
    name: "kait_hook_test",
    srcs: ["hook/src/lib.rs"],
    edition: "2021",
    rustlibs: [
        "libhashbrown",
        "libparking_lot",
        "libsmallvec",
    ],
    test_suites: ["general-tests"],
}

rust_library {
    name: "libkait_elf",
    crate_name: "kait_elf",
    srcs: ["elf/src/lib.rs"],
    edition: "2021",
    host_supported: true,
    rustlibs: [
        "liblibc",
    ],
}

rust_test_host {
    name: "kait_elf_test",
    srcs: ["elf/src/lib.rs"],
    edition: "2021",
    rustlibs: [
        "liblibc",
    ],
    test_suites: ["general-tests"],
}

rust_library {
    name: "libkait_inline",
    crate_name: "kait_inline",
    srcs: ["inline/src/lib.rs"],
    edition: "2021",
    host_supported: true,
    rustlibs: [
        "libhashbrown",
        "liblibc",
        "libparking_lot",
    ],
}

rust_test_host {
    name: "kait_inline_test",
    srcs: ["inline/src/lib.rs"],
    edition: "2021",
    rustlibs: [
        "libhashbrown",
        "liblibc",
        "libparking_lot",
    ],
    test_suites: ["general-tests"],
}

rust_ffi_shared {
    name: "libyasvara_kait",
    crate_name: "yasvara_kait",
    srcs: ["jni/src/lib.rs"],
    edition: "2021",
    system_ext_specific: true,
    compile_multilib: "both",
    prefer_rlib: true,
    rustlibs: [
        "libjni_sys",
        "libkait_dex",
        "libkait_elf",
        "libkait_hook",
        "libkait_inline",
        "liblibc",
        "libparking_lot",
        "libsmallvec",
    ],
    shared_libs: [
        "liblog",
    ],
    version_script: "jni/libyasvara_kait.map.txt",
    ld_flags: [
        "-Wl,--gc-sections",
        "-Wl,-z,max-page-size=16384",
        "-Wl,--build-id=none",
    ],
}
