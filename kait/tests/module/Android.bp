//
// Minimal Xposed test module exercising Kait on a device. Build by name and `adb install`.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "YasvaraKaitTestModule",
    srcs: ["src/**/*.java"],
    libs: ["yasvara-kait"],
    platform_apis: true,
    manifest: "AndroidManifest.xml",
    optimize: {
        enabled: false,
    },
    dex_preopt: {
        enabled: false,
    },
    certificate: "platform",
}
