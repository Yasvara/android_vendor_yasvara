#
# The root daemon. system_server starts and stops it (ctl.start / ctl.stop) from the master
# switch in grants.v1, once boot has completed, so it never competes with the boot-time
# overlay/vold commits. No property names it, and this file is unreadable to apps
# (sepolicy_file): the service name is the only trace, and its status property lives in a
# context no app can read. It binds its own socket in /data/misc/yasvara_root.

on post-fs-data
    # 0771: `shell` must traverse to run/ctl.sock (adb shell su). Apps cannot: SELinux gives them no
    # search on this directory, and Zygote hands an enrolled app a bind of the socket instead.
    mkdir /data/misc/yasvara_root 0771 system system
    restorecon /data/misc/yasvara_root

service yasvara_sessiond /system/xbin/yasvara_rootd
    user root
    group root system
    disabled
    # SIGTERM first: the daemon removes its socket and the projection set before it exits.
    gentle_kill
    oom_score_adjust -900
    ioprio be 7
    seclabel u:r:yasvara_rootd:s0
