// SPDX-License-Identifier: GPL-3.0-or-later
//
// ROM-Native Zygisk runtime. onyx is arm64-only (no zygote32), so this library is 64-bit.
// Loaded lazily inside scoped Zygote children only (zero Zygote pollution, zero idle daemon).

package {
    default_applicable_licenses: ["vendor_yasvara_zygisk_license"],
}

license {
    name: "vendor_yasvara_zygisk_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-GPL-3.0-or-later"],
    license_text: ["LICENSE"],
}

rust_ffi_shared {
    name: "libyasvara_zygisk",
    crate_name: "yasvara_zygisk",
    srcs: ["src/lib.rs"],
    edition: "2021",
    system_ext_specific: true,
    compile_multilib: "64",
    prefer_rlib: true,
    rustlibs: [
        "libyasvara_root_proto",
        "liblibc",
    ],
    shared_libs: [
        "libdl",
        "liblog",
    ],
    version_script: "libyasvara_zygisk.map.txt",
    ld_flags: [
        "-Wl,--gc-sections",
        "-Wl,-z,max-page-size=16384",
        "-Wl,--build-id=none",
    ],
}

rust_binary {
    name: "yasvara_zygisk_companion",
    srcs: ["src/companion_bin.rs"],
    edition: "2021",
    system_ext_specific: true,
    compile_multilib: "64",
    rustlibs: [
        "liblibc",
    ],
}

rust_test_host {
    name: "yasvara_zygisk_host_test",
    srcs: ["src/lib.rs"],
    edition: "2021",
    rustlibs: [
        "libyasvara_root_proto",
        "liblibc",
    ],
    test_suites: ["general-tests"],
}
