// SPDX-FileCopyrightText: The Yasvara Project
// SPDX-License-Identifier: Apache-2.0
//
// ROM-Native Zygisk runtime (API v4 & v5) — pure Rust, multilib (arm64-v8a + armeabi-v7a),
// loaded lazily inside scoped Zygote children only (zero Zygote pollution, zero idle daemon).

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_ffi_shared {
    name: "libyasvara_zygisk",
    crate_name: "yasvara_zygisk",
    srcs: ["src/lib.rs"],
    edition: "2021",
    system_ext_specific: true,
    compile_multilib: "both",
    prefer_rlib: true,
    rustlibs: [
        "libyasvara_root_proto",
        "liblibc",
    ],
    shared_libs: [
        "libdl",
        "liblog",
    ],
    version_script: "libyasvara_zygisk.map.txt",
    ld_flags: [
        "-Wl,--gc-sections",
        "-Wl,-z,max-page-size=16384",
        "-Wl,--build-id=none",
    ],
}

rust_binary {
    name: "yasvara_zygisk_companion",
    srcs: ["src/companion_bin.rs"],
    edition: "2021",
    system_ext_specific: true,
    rustlibs: [
        "liblibc",
    ],
}

rust_test_host {
    name: "yasvara_zygisk_host_test",
    srcs: ["src/lib.rs"],
    edition: "2021",
    rustlibs: [
        "libyasvara_root_proto",
        "liblibc",
    ],
    test_suites: ["general-tests"],
}
