on early-boot
    chown system system /dev/lirc0

service vendor.ir-default /vendor/bin/hw/android.hardware.ir-service.yasvara
    interface aidl android.hardware.ir.IConsumerIr/default
    class hal
    user system
    group system
    oneshot
    disabled
